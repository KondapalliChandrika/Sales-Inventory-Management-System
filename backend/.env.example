# ---- App ----
APP_NAME="Sales & Inventory API"
DEBUG=false
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173"]

# ---- Database ----
DATABASE_URL=mysql+pymysql://root:your_password@localhost:3306/sales_inventory

# ---- Auth ----
JWT_SECRET=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ---- Email (use Mailtrap / MailHog in development) ----
EMAIL_ENABLED=false
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@salesinventory.local
SMTP_USE_TLS=true

# ---- Business defaults (used only when the settings table is empty) ----
DEFAULT_APPROVAL_THRESHOLD=50000
DEFAULT_TAX_RATE_PERCENT=18

# ---- Startup ----
# Create the database (if missing) and apply migrations automatically when the API starts.
AUTO_MIGRATE=true
# Add demo users/products/customers on startup when the database has no users.
AUTO_SEED=true
